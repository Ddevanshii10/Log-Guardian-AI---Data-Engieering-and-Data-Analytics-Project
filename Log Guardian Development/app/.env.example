# Copy to .env and fill in. Never commit .env — add it to .gitignore.

# --- Databricks SQL warehouse (where the Gold views live) -------------------------
DATABRICKS_SERVER_HOSTNAME=dbc-4b57f0e0-22f0.cloud.databricks.com
# SQL Warehouses -> your warehouse -> Connection details -> HTTP path
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/REPLACE_WITH_WAREHOUSE_ID
# User Settings -> Developer -> Access tokens -> Generate new token
DATABRICKS_TOKEN=dapiREPLACE_WITH_TOKEN

DATABRICKS_CATALOG=log-analytics
DATABRICKS_SCHEMA=gold

# --- Optional: live Q&A on the Ask tab -------------------------------------------
# A chat-capable serving endpoint. Leave blank and the Ask tab explains it is
# unavailable instead of failing. The other three tabs never need this.
DATABRICKS_LLM_ENDPOINT=

# --- Optional: run with no warehouse at all --------------------------------------
# Set to 1 to read app/snapshot/*.csv instead of Databricks. Generate the snapshot
# with: python export_snapshot.py
LOG_GUARDIAN_USE_SNAPSHOT=0
